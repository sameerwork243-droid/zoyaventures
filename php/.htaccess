# .htaccess — clean URLs → index.php front controller (shared hosting, Apache)

Options -Indexes
DirectoryIndex index.php

# Protect sensitive files
<FilesMatch "^(\.env|\.env\.local|schema\.sql|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# No PHP execution inside uploads (uploaded content is images only)
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]
</IfModule>

# Static assets → serve directly
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing files/dirs (css, js, images, static, media, data/raw JSON snapshots)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → front controller
  RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>